<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="obstacle_course">
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Core Gazebo systems for rendering and physics. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Needed by ros_gz_sim create so the robot can be inserted into the world. -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.3 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>30 30 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>30 30 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.025 0 0 0</pose>
    </model>

    <model name="front_wall">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 4.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 4.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.35 0.2 1</ambient>
            <diffuse>0.9 0.35 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>4.0 0 0.5 0 0 0</pose>
    </model>

    <model name="left_block">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.55 0.85 1</ambient>
            <diffuse>0.2 0.55 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>2.5 1.4 0.4 0 0 0</pose>
    </model>

    <model name="right_block">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 1.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.75 0.35 1</ambient>
            <diffuse>0.3 0.75 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>6.0 -1.3 0.5 0 0 0</pose>
    </model>

    <model name="corridor_wall">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 6.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 6.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.25 1</ambient>
            <diffuse>0.7 0.7 0.25 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>8.0 0 0.5 0 0 0</pose>
    </model>
  </world>
</sdf>
